# Publish the overlay and its player documentation using an explicit allowlist.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Build-Overlay.ps1
!/THIRD_PARTY_NOTICES.md
!/artmo.ini
!/rulesmo.ini
!/Soundmo.INI
!/thememo.ini
!/uimd.ini
!/ra2md.csf
!/digits.shp
!/pips.shp
!/game.fnt
!/expandmo34.mix
!/expandmo35.mix
!/Phobos.dll
!/INI/
/INI/*
!/INI/MentalOmegaMaps.ini
!/Resources/
/Resources/*
!/Resources/GameOptions.ini
!/MapsMO/
/MapsMO/*
!/MapsMO/Demonic Modification/
!/licenses/
!/docs/
/docs/*
!/docs/LICENSING.md
!/docs/INSTALL.md
!/docs/modified-wiki/
/docs/modified-wiki/*
!/docs/modified-wiki/html-refine/

# Keep agent workspaces, instructions, and memory private at every depth.
[Aa][Gg][Ee][Nn][Tt]/
[Aa][Gg][Ee][Nn][Tt][Ss].*
[Mm][Ee][Mm][Oo][Rr][Yy].*
[Cc][Ll][Aa][Uu][Dd][Ee].*
[Gg][Ee][Mm][Ii][Nn][Ii].*

# Local baselines, diagnostics, backups, and personal game preferences.
/MO336-official/
/_diag/
/RA2MO.ini
*.bak
*.backup
*.tmp
*.log
*.dmp
~$*

# Local credentials, environments, and editor state.
.env
.env.*
*.pem
*.key
.venv/
venv/
__pycache__/
node_modules/
.vs/
.vscode/
.idea/
Thumbs.db
.DS_Store

# Generated ZIPs and manifests are published as release assets, not Git blobs.
/dist/
